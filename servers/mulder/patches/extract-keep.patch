diff --git a/tests/test_extract_inode_keeps_file.py b/tests/test_extract_inode_keeps_file.py
new file mode 100644
index 0000000..7facea1
--- /dev/null
+++ b/tests/test_extract_inode_keeps_file.py
@@ -0,0 +1,45 @@
+"""extract_file_by_inode keeps a binary file on disk so other tools can read it."""
+
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+from typing import Any
+from unittest.mock import MagicMock, patch
+
+from mulder.server.tools.tsk import extract_file_by_inode
+
+BINARY = b"MZ\x90\x00\x03\x00\x00\x00" + b"\x00" * 64
+
+
+def _invoke(tmp_path: Path, stdout: bytes) -> Any:
+    proc = subprocess.CompletedProcess(args=["icat"], returncode=0, stdout=stdout, stderr=b"")
+    cfg = MagicMock(db_dir=tmp_path)
+    with (
+        patch("mulder.server.tools.tsk.get_ctx", return_value=MagicMock()),
+        patch("mulder.server.tools.tsk.get_cfg", return_value=cfg),
+        patch("mulder.server.tools.tsk.shutil.which", return_value="/usr/bin/icat"),
+        patch(
+            "mulder.server.tools.tsk._resolve_image_and_offset",
+            return_value=("img.E01", 63, "ntfs"),
+        ),
+        patch("mulder.server.tools.tsk.subprocess.run", return_value=proc),
+    ):
+        return extract_file_by_inode.__wrapped__(10273)  # type: ignore[attr-defined]
+
+
+def test_a_binary_file_is_saved_and_its_path_returned(tmp_path: Path) -> None:
+    result = _invoke(tmp_path, BINARY)
+
+    path = Path(result["results"]["path"])
+    assert path.is_relative_to(tmp_path / "extracted")
+    assert path.read_bytes() == BINARY
+    assert result["results"]["size_bytes"] == len(BINARY)
+
+
+def test_a_text_file_is_indexed_not_saved(tmp_path: Path) -> None:
+    with patch("mulder.server.tools.tsk.extract_and_index", return_value={"windows_indexed": 1}):
+        result = _invoke(tmp_path, b"plain text\n")
+
+    assert "path" not in result["results"]
+    assert not (tmp_path / "extracted").exists()
