+
+
+def test_an_image_scan_is_partial_with_no_count(tmp_path: Path) -> None:
+    image = tmp_path / "disk.E01"
+    image.write_bytes(b"EVF")
+
+    result = _invoke(image)
+
+    assert result["status"] == "partial"
+    assert '"detections": null' in str(result["preview"])
+    assert '"partial": true' in str(result["preview"])
+
+
+def test_the_indexed_text_starts_with_the_note(tmp_path: Path) -> None:
+    image = tmp_path / "disk.E01"
+    image.write_bytes(b"EVF")
+
+    _invoke(image)
+
+    assert INDEXED[0].startswith("NOTE: clamscan read disk.E01")
+
+
+def test_a_plain_folder_scan_is_still_a_success(tmp_path: Path) -> None:
+    (tmp_path / "a.exe").write_bytes(b"MZ")
+
+    result = _invoke(tmp_path)
+
+    assert result["status"] == "success"
+    assert '"detections": 0' in str(result["preview"])
