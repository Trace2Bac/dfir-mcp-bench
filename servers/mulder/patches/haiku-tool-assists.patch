+def _has_pcap_header(image_path: str, inode_str: str, offset: int) -> bool:
+    """Read the first bytes of a file through icat and compare them with capture headers."""
+    cmd = ["icat"]
+    if offset > 0:
+        cmd.extend(["-o", str(offset)])
+    cmd.extend([image_path, inode_str])
+    try:
+        with subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL) as proc:
+            assert proc.stdout is not None
+            head = proc.stdout.read(4)
+            proc.kill()
+    except OSError as exc:
+        logger.warning("icat header read failed for inode %s: %s", inode_str, exc)
+        return False
+    return head in _PCAP_MAGICS
+
