+def _ewf_first_segments(target_path: str) -> list[Path]:
+    """EWF images at *target_path* (the file, or files directly in the folder)."""
+    path = Path(target_path)
+    candidates = [path] if path.is_file() else sorted(p for p in path.glob("*") if p.is_file())
