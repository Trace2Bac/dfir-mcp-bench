+def _extensionless_files(
+    fls_chunks: list[str],
+    offset: int,
+) -> list[tuple[str, str, int]]:
+    """Files in the listing whose name has no extension, as (inode, path, offset)."""
+    found: list[tuple[str, str, int]] = []
+    seen: set[str] = set()
+    for chunk in fls_chunks:
+        for entry in fls_file_entries(chunk):
+            if "." in entry.path.rsplit("/", 1)[-1]:
+                continue
+            if entry.base_inode in seen:
