+def _plan_image_path(tasks: list[dict[str, Any]]) -> str | None:
+    """The disk image the plan works on, from run_fls or any image argument."""
+    candidates: list[str] = []
+    for task in tasks:
+        args = task.get("args")
+        if not isinstance(args, dict):
+            continue
+        for value in args.values():
+            if isinstance(value, str) and value.lower().endswith(_DISK_IMAGE_SUFFIXES):
+                if task.get("tool") == "run_fls":
+                    return value
+                candidates.append(value)
+    return candidates[0] if candidates else None
+
+
+def _add_baseline_tasks(tasks: list[dict[str, Any]], executor_allowed: list[str]) -> list[str]:
+    """Append the disk-image tools the plan left out; return their names."""
+    image = _plan_image_path(tasks)
+    if image is None:
+        return []
+    planned = {str(task.get("tool")) for task in tasks}
+    wanted = list(_DISK_IMAGE_BASELINE)
+    if planned & _WINDOWS_PLAN_TOOLS:
+        wanted.extend(_WINDOWS_IMAGE_BASELINE)
+    allowed = frozenset(executor_allowed)
+    added: list[str] = []
+    for tool in wanted:
+        if tool in planned or f"mcp__mulder__{tool}" not in allowed:
+            continue
+        if tool == "run_hashdeep":
+            args = {"target_path": str(PurePosixPath(image).parent)}
+        else:
+            args = {"image_path": image}
+        tasks.append(
+            {
+                "tool": tool,
+                "args": args,
+                "purpose": "Required for a disk image; added because the plan left it out",
+            }
+        )
+        added.append(tool)
+    return added
+
