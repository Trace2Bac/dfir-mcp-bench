+# smaller files cannot be captures.
+_MIN_CAPTURE_BYTES = 24
+
+# Captures are files a user saved: look in user folders first and in the
+# operating system's folders last, so the limit above cuts the least likely.
+_USER_DIRS = ("users/", "documents and settings/", "home/", "root/")
+_SYSTEM_DIRS = (
+    "windows/",
+    "winnt/",
+    "program files",
+    "programdata/",
+    "$",
+    "system volume information/",
+)
