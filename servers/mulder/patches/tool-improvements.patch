+        check["status"] = "verified"
+    elif "ewfverify: FAILURE" in proc.stdout:
+        stored = any(k.startswith("stored_") for k in check)
+        check["status"] = "mismatch" if stored else "no_stored_hash"
+    else:
+        check["status"] = "not_checked"
+        detail = (proc.stderr or "").strip() or proc.stdout.strip()
+        check["reason"] = detail[:_PREVIEW_CHAR_LIMIT]
+    return check
+
+
+def _acquisition_hash_line(check: dict[str, object]) -> str:
+    """One sentence on what ewfverify found for one image."""
+    name = check["image"]
+    stored = ", ".join(f"{k[7:].upper()} {v}" for k, v in check.items() if k.startswith("stored_"))
+    calculated = ", ".join(
+        f"{k[11:].upper()} {v}" for k, v in check.items() if k.startswith("calculated_")
+    )
+    status = check["status"]
+    if status == "verified":
+        return (
+            f"{name}: acquisition hash stored in the image {stored}; ewfverify recomputed "
+            f"it over the media data ({calculated}) and the two match."
+        )
+    if status == "mismatch":
+        return (
+            f"{name}: acquisition hash stored in the image {stored} does NOT match the hash "
+            f"ewfverify recomputed over the media data ({calculated})."
+        )
+    if status == "no_stored_hash":
+        return (
+            f"{name}: no acquisition hash is stored in the image, so it cannot be verified; "
+            f"media hash computed by ewfverify: {calculated or 'none reported'}."
+        )
+    reason = check.get("reason", "unknown error")
+    if status == "failed":
+        return f"{name}: the acquisition hash could not be verified: {reason}."
+    return f"{name}: the acquisition hash was not checked ({reason})."
 
 
