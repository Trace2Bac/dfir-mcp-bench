+def _file_sizes(image_path: str, offset: int) -> dict[str, int]:
+    """File sizes by inode, from fls body output; empty when fls fails."""
+    cmd = ["fls", "-r", "-m", "/", *(["-o", str(offset)] if offset > 0 else []), image_path]
+    try:
+        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=600, check=False)
+    except (subprocess.TimeoutExpired, OSError) as exc:
+        logger.warning("fls -m failed on %s: %s", image_path, exc)
+        return {}
+    sizes: dict[str, int] = {}
+    for line in proc.stdout.splitlines():
+        # MD5|name|inode|mode|UID|GID|size|atime|mtime|ctime|crtime
+        fields = line.split("|")
+        if len(fields) >= 7 and fields[6].isdigit():
+            sizes[fields[2].split("-")[0]] = int(fields[6])
+    return sizes
+
+
+def _has_pcap_header(image_path: str, inode_str: str, offset: int) -> bool:
+    """Read the first bytes of a file through icat and compare them with capture headers."""
+    cmd = ["icat"]
+    if offset > 0:
+        cmd.extend(["-o", str(offset)])
+    cmd.extend([image_path, inode_str])
+    try:
+        with subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL) as proc:
+            assert proc.stdout is not None
+            head = proc.stdout.read(4)
+            proc.kill()
+    except OSError as exc:
+        logger.warning("icat header read failed for inode %s: %s", inode_str, exc)
+        return False
+    return head in _PCAP_MAGICS
