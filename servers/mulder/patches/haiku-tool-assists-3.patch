+def _scan_image_contents(image: Path) -> dict[str, object]:
+    """Copy the files out of a disk image with tsk_recover and scan them with clamscan.
+
+    Allocated and deleted files with recoverable content, on the partition
+    the case uses for this image.
+    """
+    scan: dict[str, object] = {"image": image.name}
+    if not require_binary("tsk_recover"):
+        scan["status"] = "not_scanned"
+        scan["reason"] = "tsk_recover not found on PATH"
+        return scan
+    offset = _resolve_partition_offset(str(image))
+    scan["partition_offset"] = offset
+    tmp = Path(tempfile.mkdtemp(prefix="mulder_clamav_"))
+    try:
+        cmd = ["tsk_recover", "-e", *(["-o", str(offset)] if offset > 0 else [])]
+        proc = subprocess.run(
+            [*cmd, str(image), str(tmp)],
+            capture_output=True,
+            text=True,
+            timeout=_IMAGE_SCAN_TIMEOUT,
+            check=False,
+        )
+        files = [
+            p for p in tmp.rglob("*") if p.is_file() and p.name.lower() not in _IMAGE_SCAN_SKIP
+        ]
+        if proc.returncode != 0 and not files:
+            scan["status"] = "not_scanned"
+            scan["reason"] = f"tsk_recover failed: {(proc.stderr or '').strip()[:300]}"
+            return scan
+        files.sort(key=lambda p: p.stat().st_size, reverse=True)
+        lists = []
+        for n in range(_IMAGE_SCAN_WORKERS):
+            share = files[n::_IMAGE_SCAN_WORKERS]
+            if share:
