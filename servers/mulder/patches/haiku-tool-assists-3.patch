+                stdout=subprocess.PIPE,
+                stderr=subprocess.DEVNULL,
+                text=True,
+            )
+            for list_file in lists
+        ]
+        found: list[str] = []
+        timed_out = False
+        deadline = time.monotonic() + _IMAGE_SCAN_TIMEOUT
+        for worker in workers:
