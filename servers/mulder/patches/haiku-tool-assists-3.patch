+def _nested_source_names(value: object, depth: int = 0) -> list[str]:
+    """Sources a tool indexed itself and lists inside its results.
+
+    analyze_disk_pcaps, for one, indexes one source per capture
+    (``pcap.disk.<name>``) and returns them only within ``analyses``.
+    """
+    names: list[str] = []
+    if depth > 3:
+        return names
+    if isinstance(value, dict):
+        name = value.get("source_name")
+        if isinstance(name, str) and name:
+            names.append(name)
+        for item in value.values():
+            if isinstance(item, (dict, list)):
+                names.extend(_nested_source_names(item, depth + 1))
+    elif isinstance(value, list):
+        for item in value:
+            names.extend(_nested_source_names(item, depth + 1))
+    return list(dict.fromkeys(names))
+
