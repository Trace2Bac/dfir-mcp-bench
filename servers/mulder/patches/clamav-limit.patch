+# Disk image formats that clamscan reads as one opaque file.
+_DISK_IMAGE_SUFFIXES = frozenset(
+    {".e01", ".ex01", ".s01", ".l01", ".aff", ".dd", ".raw", ".img", ".001"}
+    | {".vmdk", ".vhd", ".vhdx"}
+)
+
+
+def _disk_image_names(target_path: str) -> list[str]:
+    """Names of the disk images at *target_path*: the file, or files under the folder."""
+    path = Path(target_path)
+    candidates = [path] if path.is_file() else sorted(p for p in path.rglob("*") if p.is_file())
+    return [p.name for p in candidates if p.suffix.lower() in _DISK_IMAGE_SUFFIXES]
+
+
 @mcp.tool()
 @tool_access(Role.EXTRACT_EXECUTOR)
