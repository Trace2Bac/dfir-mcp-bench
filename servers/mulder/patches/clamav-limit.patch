+# Disk image files that clamscan reads as one opaque file: EnCase and other
+# segmented images (every segment, .E01, .E02, ...), raw and virtual disks.
+_DISK_IMAGE_SUFFIX = re.compile(
+    r"\.(e\d{2}|ex\d{2}|s\d{2}|l\d{2}|\d{3}|aff|dd|raw|img|vmdk|vhd|vhdx)$", re.IGNORECASE
+)
+
+
+def _disk_image_names(target_path: str) -> list[str]:
+    """Names of the disk images at *target_path*: the file, or files under the folder."""
+    path = Path(target_path)
+    candidates = [path] if path.is_file() else sorted(p for p in path.rglob("*") if p.is_file())
+    return [p.name for p in candidates if _DISK_IMAGE_SUFFIX.search(p.name)]
+
+
