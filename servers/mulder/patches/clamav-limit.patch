@@ -0,0 +1,53 @@
+"""A ClamAV scan of a disk image says that the files inside it were not scanned."""
+
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+from typing import Any
+from unittest.mock import patch
+
+from mulder.server.tools.extract.misc import run_clamav
+
+CLEAN = subprocess.CompletedProcess(args=["clamscan"], returncode=0, stdout="", stderr="")
+
+
+def _invoke(target: Path) -> Any:
+    def _index(raw: str, *args: object, **kwargs: object) -> dict[str, object]:
+        return {"source_name": "clamav.scan", "windows_indexed": 0, "line_count": 0}
+
+    with (
+        patch("mulder.server.tools.extract.misc.require_binary", return_value=True),
+        patch("mulder.server.tools.extract.misc.subprocess.run", return_value=CLEAN),
+        patch("mulder.server.tools.extract.misc.extract_and_index", side_effect=_index),
+    ):
+        return run_clamav.__wrapped__(str(target))  # type: ignore[attr-defined]
+
+
+def test_scanning_a_disk_image_says_its_files_were_not_scanned(tmp_path: Path) -> None:
+    image = tmp_path / "disk.E01"
+    image.write_bytes(b"EVF")
+
+    message = str(_invoke(image)["message"])
+
+    assert "disk.E01" in message
+    assert "files inside were not scanned" in message
+    assert "does not show" in message
+
+
+def test_a_folder_with_images_names_them(tmp_path: Path) -> None:
+    (tmp_path / "case").mkdir()
+    (tmp_path / "case" / "pc.E01").write_bytes(b"EVF")
+    (tmp_path / "case" / "pc.E02").write_bytes(b"EVF")
+    (tmp_path / "case" / "notes.txt").write_text("x\\n")
+
+    message = str(_invoke(tmp_path / "case")["message"])
+
+    assert "pc.E01" in message
+    assert "notes.txt" not in message
+
+
+def test_a_folder_of_plain_files_has_no_message(tmp_path: Path) -> None:
+    (tmp_path / "a.exe").write_bytes(b"MZ")
+
+    assert "message" not in _invoke(tmp_path)
