diff --git a/tests/test_tool_messages_carry.py b/tests/test_tool_messages_carry.py
new file mode 100644
index 0000000..7f5c29e
--- /dev/null
+++ b/tests/test_tool_messages_carry.py
@@ -0,0 +1,77 @@
+"""Extraction tool messages reach the later phases' prompts."""
+
+from __future__ import annotations
+
+from typing import Any
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from mulder.orchestrator.models import ModelConfig
+from mulder.orchestrator.phases import ALTERNATIVE_NARRATIVE, EXTRACTION
+from mulder.orchestrator.roles import RoleRunner
+from mulder.orchestrator.types import ExecutionResults, Plan
+
+PCAP_MESSAGE = (
+    "No packet capture files found in the TSK file listing. Files without an "
+    "extension were not opened."
+)
+
+
+def _roles() -> tuple[RoleRunner, AsyncMock]:
+    roles = RoleRunner(MagicMock(), MagicMock(), ModelConfig(), "c", {}, "/tmp", max_compactions=0)
+    session = AsyncMock(return_value=MagicMock())
+    roles._analyst_session = session  # type: ignore[method-assign]
+    return roles, session
+
+
+def _results(*results: dict[str, Any]) -> ExecutionResults:
+    return ExecutionResults("p", list(results), 1, False)
+
+
+def _plan() -> Plan:
+    return Plan("p", [], [], [], "", 0)
+
+
+async def test_extraction_messages_are_kept_once_in_order() -> None:
+    roles, _ = _roles()
+    results = _results(
+        {"tool": "analyze_disk_pcaps", "status": "ok", "message": PCAP_MESSAGE},
+        {"tool": "run_fls", "status": "ok"},
+        {"tool": "analyze_disk_pcaps", "status": "ok", "message": PCAP_MESSAGE},
+    )
+    await roles.run_analyst(EXTRACTION, _plan(), results, {"case_id": "c", "system_name": "s"})
+
+    block = roles.tool_messages_block()
+    assert block.count(PCAP_MESSAGE) == 1
+    assert "run_fls" not in block
+
+
+async def test_later_phase_analyst_prompt_ends_with_the_messages() -> None:
+    roles, session = _roles()
+    extraction = _results({"tool": "analyze_disk_pcaps", "status": "ok", "message": PCAP_MESSAGE})
+    await roles.run_analyst(EXTRACTION, _plan(), extraction, {"case_id": "c", "system_name": "s"})
+
+    later = {"case_id": "c", "tool_messages": roles.tool_messages_block()}
+    await roles.run_analyst(ALTERNATIVE_NARRATIVE, _plan(), _results(), later)
+
+    prompt = session.call_args_list[-1].args[1]
+    assert prompt.rstrip().endswith(f"analyze_disk_pcaps: {PCAP_MESSAGE}")
+
+
+async def test_later_phase_messages_are_not_collected() -> None:
+    roles, _ = _roles()
+    narrative = _results({"tool": "search", "status": "ok", "message": "3 hits"})
+    await roles.run_analyst(ALTERNATIVE_NARRATIVE, _plan(), narrative, {"case_id": "c"})
+
+    assert roles.tool_messages_block() == ""
+
+
+@pytest.mark.parametrize("prompt_vars", [None, {}, {"tool_messages": ""}])
+async def test_no_messages_leave_the_prompt_unchanged(
+    prompt_vars: dict[str, str] | None,
+) -> None:
+    roles, session = _roles()
+    await roles.run_analyst(ALTERNATIVE_NARRATIVE, _plan(), _results(), prompt_vars)
+
+    assert "TOOL MESSAGES" not in session.call_args_list[-1].args[1]
