+# Audit params that name the evidence a tool ran on.
+_PATH_PARAMS = ("path", "root_path")
+
+# Tools that list or look around artifacts of a class without reading the
+# files themselves, so they do not make a file examined.
+_LOCATOR_TOOLS = {"find_shell_histories", "find_webshells", "verify_package_integrity"}
+
+
+def _examined_paths(entries: list[dict], tools: set[str]) -> list[Path]:
+    """Resolved paths that any of *tools* ran on, per the audit trail."""
+    paths: list[Path] = []
+    for e in entries:
+        if e.get("tool") not in tools or e.get("tool") in _LOCATOR_TOOLS:
+            continue
+        params = e.get("params") or {}
+        for key in _PATH_PARAMS:
+            value = params.get(key)
+            if isinstance(value, str) and value:
+                paths.append(Path(value).resolve())
+    return paths
+
+
+def _is_examined(location: str, examined: list[Path]) -> bool:
+    """True if a tool ran on this location or on a folder that holds it."""
+    target = (EVIDENCE_DIR / location).resolve()
+    return any(p == target or p in target.parents for p in examined)
+
+
