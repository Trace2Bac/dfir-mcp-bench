# Model served by LM Studio on the host (Developer tab > Start Server, port 1234).
# The runner reaches it from inside Docker through host.docker.internal.
# Leave MODEL_NAME empty to use the first loaded model.
MODEL_BASE_URL=http://host.docker.internal:1234/v1
MODEL_NAME=
MODEL_API_KEY=lm-studio
TEMPERATURE=0
MODEL_TIMEOUT_S=900
# Cap on one reply, reasoning included, so a reasoning loop cannot run until
# the timeout. A run that hits an error is still scored and records why.
MODEL_MAX_TOKENS=8192
# Sent as reasoning_effort; `none` turns thinking off in LM Studio. Empty
# leaves the model's default. A set value is added to the results folder name.
MODEL_REASONING_EFFORT=
# `./bench.sh investigate` with Claude models reads ANTHROPIC_API_KEY from the
# environment. Prefer `export ANTHROPIC_API_KEY=...` in the shell over putting
# it here; .env is git-ignored, but a key in a file is easy to leak.
