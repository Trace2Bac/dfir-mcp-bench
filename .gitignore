# Evidence is never committed: datasets/ holds the scripts that fetch or build it.
data/
.env
# Scratch output of `./bench.sh check`.
.check/
__pycache__/
# Results are published, except each run's case database, which holds indexed
# copies of the evidence. The audit log and server log next to it are kept.
results/**/server-db/*.db
results/**/server-db/*.db-*
